
Table s17_users {
  id integer [pk, increment]
  username varchar(50) [not null, unique]
}

Table s17_posts {
  id integer [pk, increment]
  user_id integer
  caption text
  location varchar(100)
  created_at timestamp
}

Table s17_comments {
  id integer [pk, increment]
  post_id integer
  user_id integer
  comment_text text
}

Table s17_mentions {
  id integer [pk, increment]
  post_id integer
  mentioned_user_id integer
  mention_type varchar(20)
  created_at timestamp
}

Ref: s17_posts.user_id > s17_users.id
Ref: s17_comments.post_id > s17_posts.id
Ref: s17_comments.user_id > s17_users.id
Ref: s17_mentions.post_id > s17_posts.id
Ref: s17_mentions.mentioned_user_id > s17_users.id
